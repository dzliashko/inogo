      "./..."
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Go: Build All",
    "command": "go",
    "args": [
      "build",
      "./..."
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Go: Mod Tidy",
